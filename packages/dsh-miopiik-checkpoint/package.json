{
  "name": "dsh-miopiik-checkpoint",
  "description": "Compatibility auto-checkpoint plugin for MiOpIIk 0.1.x-style installs; MiOpIIk 0.2 default runtime moves this behavior into dsh-miopiik-tool-recovery. 兼容包：0.2 默认由 recovery 承担自动检查点",
  "version": "0.1.13",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "checkpoint",
    "memory"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chillizu/mop-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/Chillizu/mop-plugins/issues"
  },
  "homepage": "https://github.com/Chillizu/mop-plugins/tree/main/packages/dsh-miopiik-checkpoint#readme"
}
