{
  "name": "dsh-session-policy",
  "description": "MiOpIIk: session-scoped hard rules (session_rule) and DSH seam/token diagnostics (session_doctor) — the model-visible surface DSH deliberately withholds. Named recovery points moved to dsh-agent-rewind.",
  "version": "0.5.2",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "engines": {
    "node": ">=22.15"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "rules",
    "diagnostics",
    "capabilities",
    "miopiik"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chillizu/mop-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/Chillizu/mop-plugins/issues"
  },
  "homepage": "https://github.com/Chillizu/mop-plugins#readme",
  "files": [
    "README.md",
    "index.js",
    "session-rules.js",
    "diagnostics.js",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-agent-rewind": "^0.5.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  }
}
