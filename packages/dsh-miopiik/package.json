{
  "name": "dsh-miopiik",
  "description": "MiOpIIk workflow and recovery extensions for DeepSeek Harness 0.1.7-rc.2; native DSH owns subagent routing, model authorization, skill loading, and session search.",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.15"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "agent-workflow",
    "subagents",
    "checkpoint",
    "miopiik"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chillizu/mop-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/Chillizu/mop-plugins/issues"
  },
  "homepage": "https://github.com/Chillizu/mop-plugins#readme",
  "bin": {
    "dsh-miopiik": "bin/dsh-miopiik-init.mjs",
    "dsh-miopiik-init": "bin/dsh-miopiik-init.mjs"
  },
  "files": [
    "cordis.patch.yml",
    "bin/",
    "preset/"
  ],
  "exports": {
    ".": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-miopiik-capabilities": "^0.3.0",
    "dsh-miopiik-checkpoint": "^0.3.0",
    "dsh-miopiik-diagnostics": "^0.3.0",
    "dsh-miopiik-learn": "^0.3.0",
    "dsh-miopiik-magic-keywords": "^0.3.0",
    "dsh-miopiik-run-stats": "^0.3.0",
    "dsh-miopiik-tool-recovery": "^0.3.0",
    "@deepseek-ai/dsh-tool-session-query": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "0.1.7-rc.2"
  }
}
