{
  "name": "dsh-agent-rewind",
  "description": "Session ledger for DeepSeek Harness: named recovery points (checkpoint / rewind / list) over .dsh/memory/checkpoints.md, plus event-driven structural auto-checkpoint.",
  "version": "0.5.0",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "engines": {
    "node": ">=22.15"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "session",
    "agent",
    "checkpoint",
    "rewind",
    "recovery",
    "memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chillizu/mop-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/Chillizu/mop-plugins/issues"
  },
  "homepage": "https://github.com/Chillizu/mop-plugins/tree/main/packages/dsh-agent-rewind#readme",
  "files": [
    "README.md",
    "index.js",
    "ledger.js",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  }
}
