{
  "name": "dsh-miopiik-diagnostics",
  "description": "MiOpIIk diagnostics domain: DSH compatibility/seam probing plus programmatic token usage telemetry. 诊断域：能力兼容探测 + token 遥测出口",
  "version": "0.1.13",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "diagnostics",
    "compatibility",
    "token-usage",
    "telemetry"
  ],
