{
  "name": "mop-plugins",
  "description": "Native-first DSH extension bundles: named rewind, session rules, schema diagnostics",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Chillizu/mop-plugins.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --import ./test/register-mocks.mjs --test --test-isolation=none \"test/*.test.js\"",
    "test:contract": "node test/session-contract.mjs",
    "test:composition": "node --test \"test/composition/*.test.mjs\"",
    "check": "node --check packages/dsh-agent-rewind/index.js && node --check packages/dsh-agent-rewind/ledger.js && node --check packages/dsh-session-policy/index.js && node --check packages/dsh-session-policy/session-rules.js && node --check packages/dsh-session-policy/diagnostics.js && node --check packages/mop-probe/index.js && node --check packages/mop-probe/probe.js",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0"
  }
}
